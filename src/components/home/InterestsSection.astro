---
import type { Profile } from '@/data/profile';
import { getGalleryHref } from '@/lib/homepage-state';

interface Props {
  profile: Profile | null;
}

const { profile } = Astro.props;
const galleryRouteAvailable = Object.keys(import.meta.glob('/src/pages/gallery.astro')).length > 0;
const galleryHref = getGalleryHref(profile, galleryRouteAvailable);
---

<section class="section story-section" id="interests" aria-labelledby="interests-heading">
  <div class="shell section-layout">
    <h2 id="interests-heading" data-reveal="section">Interests</h2>
    <div class="interest-copy">
      {
        profile ? (
          <>
            <p>{profile.interestsIntroduction}</p>
            {galleryHref && <a href={galleryHref}>Photography gallery</a>}
            {profile.links.instagram && <a href={profile.links.instagram} target="_blank" rel="noopener noreferrer">Follow my photography on Instagram ↗</a>}
          </>
        ) : (
          <p>Interests will appear after the owner approves the profile copy.</p>
        )
      }
    </div>
  </div>
</section>

<style>
  .interest-copy {
    display: grid;
    max-width: 55ch;
    gap: var(--space-4);
    font-size: var(--step-1);
  }

  p {
    margin: 0;
  }

  a {
    justify-self: start;
    color: var(--color-vermilion-strong);
    font-size: var(--step-0);
  }
</style>
