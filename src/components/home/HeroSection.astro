---
import HeroArtwork from '@/components/hero/HeroArtwork.astro';
import type { Profile } from '@/data/profile';

interface Props {
  profile: Profile | null;
}

const { profile } = Astro.props;
---

<section class="hero section" aria-labelledby="hero-heading">
  <HeroArtwork>
    <h1 slot="title" id="hero-heading" data-reveal="hero">
      <span>I like</span>
      <button class="interest-word" type="button" data-interest-cycle aria-label="I like photography. Change interest" style="display:block;width:max-content;max-width:85vw;min-height:1.15em;padding:0;border:0;background:transparent;color:inherit;font:inherit;font-size:.78em;letter-spacing:inherit;text-align:left;white-space:nowrap;cursor:pointer;pointer-events:auto;text-shadow:inherit">
        <span data-interest-word>photography</span>
      </button>
    </h1>
    <div class="hero-content">
      <div class="hero-copy">
        {
          profile ? (
            <>
              <p class="headline" data-reveal="hero">
                {profile.name} · AI Engineer
              </p>
            </>
          ) : null
        }
        <nav class="hero-actions" aria-label="Homepage highlights" data-reveal="hero">
          <a class="primary-action" href="#projects">View projects</a>
          <a href="#contact">Contact details</a>
        </nav>
      </div>
    </div>
  </HeroArtwork>
</section>

<script>
  function setupInterestTitle() {
    document.querySelectorAll<HTMLButtonElement>('[data-interest-cycle]:not([data-ready])').forEach((button) => {
      button.dataset.ready = 'true';
      const word = button.querySelector<HTMLElement>('[data-interest-word]')!;
      const words = ['photography', 'travel', 'creating things'];
      const reduced = matchMedia('(prefers-reduced-motion: reduce)');
      let index = 0, busy = false, disposed = false;
      let timer: ReturnType<typeof setTimeout>;
      let animation: Animation | undefined;
      const next = async () => {
        if (busy || disposed) return;
        busy = true;
        if (!reduced.matches) {
          animation = word.animate([{opacity: 1, transform: 'translateY(0)'}, {opacity: 0, transform: 'translateY(-8px)'}], {duration: 220, fill: 'forwards', easing: 'ease-in'});
          await animation.finished.catch(() => {});
        }
        if (disposed) return;
        index = (index + 1) % words.length;
        word.textContent = words[index]!;
        button.setAttribute('aria-label', `I like ${words[index]}. Change interest`);
        animation?.cancel();
        if (!reduced.matches) {
          animation = word.animate([{opacity: 0, transform: 'translateY(8px)'}, {opacity: 1, transform: 'translateY(0)'}], {duration: 380, easing: 'cubic-bezier(.16,1,.3,1)'});
          await animation.finished.catch(() => {});
        }
        busy = false;
      };
      let remaining = 3;
      const intro = async () => {
        await next();
        if (!disposed && --remaining > 0) timer = setTimeout(intro, 1600);
      };
      if (!reduced.matches) timer = setTimeout(intro, 1600);
      const interact = () => { clearTimeout(timer); remaining = 0; void next(); };
      button.addEventListener('pointerenter', (event) => { if (event.pointerType === 'mouse') interact(); });
      button.addEventListener('click', interact);
      document.addEventListener('astro:before-swap', () => { disposed = true; clearTimeout(timer); animation?.cancel(); }, {once: true});
    });
  }
  setupInterestTitle();
  document.addEventListener('astro:page-load', setupInterestTitle);
</script>

<style>
  .hero {
    min-height: 0;
    padding-block: 0;
  }

  .hero-content {
    position: absolute;
    inset: 0;
    z-index: 5;
    display: flex;
    width: min(calc(100% - 2rem), 42rem);
    min-height: 0;
    height: 100%;
    margin-inline: auto;
    align-items: flex-end;
    justify-content: center;
    padding-block: var(--space-6);
    padding-bottom: calc(4.25rem + var(--space-4));
    text-align: center;
    pointer-events: none;
  }

  .hero-copy {
    display: grid;
    gap: var(--space-3);
    justify-items: center;
  }

  .hero-summary {
    display: grid;
    gap: var(--space-3);
  }

  h1 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(3rem, 5.6vw, 5.9rem);
    font-weight: 400;
    line-height: 0.92;
    letter-spacing: -0.055em;
    text-shadow: 0 0.2rem 1.5rem rgb(4 8 18 / 0.34);
    text-wrap: balance;
  }

  h1 span {
    display: block;
  }

  .interest-word {
    display: block;
    width: max-content;
    max-width: 85vw;
    min-height: 1.15em;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    font-size: .78em;
    letter-spacing: inherit;
    text-align: left;
    white-space: nowrap;
    cursor: pointer;
    pointer-events: auto;
    text-shadow: inherit;
  }
  .interest-word:focus-visible { outline: 2px solid var(--color-focus); outline-offset: 8px; }

  .headline {
    max-width: 32ch;
    margin: 0;
    color: var(--color-ink);
    font-size: var(--step-1);
  }

  .introduction,
  .availability {
    max-width: 52ch;
    margin: 0;
    color: var(--color-ink);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    align-items: center;
    justify-content: center;
    margin-top: var(--space-2);
    pointer-events: auto;
  }

  .hero-actions a {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    padding-inline: var(--space-4);
    border: 1px solid var(--color-night-700);
    border-radius: var(--radius-small);
    text-decoration: none;
    white-space: nowrap;
  }

  .hero-actions .primary-action {
    border-color: var(--color-vermilion-strong);
    background: var(--color-vermilion-strong);
    color: var(--color-night-950);
  }

  .hero-actions .primary-action:hover {
    background: var(--color-vermilion-strong);
    color: var(--color-night-950);
  }

  @media (max-width: 47.99rem) {
    .hero-content {
      width: calc(100% - 2rem);
      padding-block: var(--space-5);
    }

    h1 {
      font-size: clamp(2.35rem, 10.5vw, 3.65rem);
      line-height: 0.94;
    }
  }
</style>
