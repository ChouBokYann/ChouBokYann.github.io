---
import type { Profile } from '@/data/profile';

interface Props {
  profile: Profile | null;
}

const { profile } = Astro.props;
---

<section class="section story-section" id="about" aria-labelledby="about-heading">
  <div class="shell section-layout">
    <h2 id="about-heading" data-reveal="section">About</h2>
    <div class="section-copy">
      {
        profile ? (
          <>
            <p>{profile.introduction}</p>
            {profile.location && <p class="supporting">Based in {profile.location}.</p>}
          </>
        ) : (
          <p>Biography content will appear after the owner approves a profile record.</p>
        )
      }
    </div>
  </div>
</section>

<style>
  .section-copy {
    max-width: 62ch;
    font-size: var(--step-1);
  }

  p {
    margin-block: 0;
  }

  .supporting {
    margin-top: var(--space-4);
    color: var(--color-ink-muted);
    font-size: var(--step-0);
  }
</style>
