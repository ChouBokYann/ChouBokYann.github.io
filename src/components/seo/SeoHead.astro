---
import { withBase } from '@/lib/url';

interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  indexable?: boolean;
  type?: 'website' | 'article';
}

const { title, description, image, imageAlt, indexable = true, type = 'website' } = Astro.props;
const site = Astro.site ?? new URL(Astro.url.origin);
const canonical = new URL(Astro.url.pathname, site);
const imageUrl = image ? new URL(withBase(image), site) : undefined;
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content={type} />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content="en_US" />
{imageUrl && <meta property="og:image" content={imageUrl} />}
{imageUrl && imageAlt && <meta property="og:image:alt" content={imageAlt} />}
<meta name="twitter:card" content={imageUrl ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
{imageUrl && <meta name="twitter:image" content={imageUrl} />}
{imageUrl && imageAlt && <meta name="twitter:image:alt" content={imageAlt} />}
<meta name="robots" content={indexable ? 'index, follow' : 'noindex, nofollow'} />
